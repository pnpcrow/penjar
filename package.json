{
  "name": "penjar",
  "version": "1.20.0",
  "license": "MPL-2.0",
  "author": "Kaleidos INC",
  "private": true,
  "packageManager": "pnpm@10.28.2+sha512.41872f037ad22f7348e3b1debbaf7e867cfd448f2726d9cf74c08f19507c31d2c8e7a11525b983febc2df640b5438dee6023ebb1f84ed43cc2d654d2bc326264",
  "repository": {
    "type": "git",
    "url": "https://github.com/penjar/penjar"
  },
  "type": "module",
  "scripts": {
    "lint": "./scripts/lint",
    "fmt": "./scripts/fmt",
    "desktop:test": "cd desktop && flutter test",
    "desktop:test:contracts": "cd desktop && ./scripts/run_contract_tests.sh",
    "desktop:test:contracts:no-pub": "cd desktop && FLUTTER_NO_PUB=1 ./scripts/run_contract_tests.sh",
    "desktop:test:coverage:check": "cd desktop && ./scripts/check_verify_test_coverage.sh",
    "desktop:docs:command-inventory:check": "cd desktop && ./scripts/check_desktop_command_inventory.sh",
    "desktop:test:parity": "cd desktop && ./scripts/run_parity_tests.sh",
    "desktop:test:parity:no-pub": "cd desktop && FLUTTER_NO_PUB=1 ./scripts/run_parity_tests.sh",
    "desktop:test:mode-matrix": "cd desktop && ./scripts/run_mode_matrix_tests.sh",
    "desktop:test:mode-matrix:no-pub": "cd desktop && FLUTTER_NO_PUB=1 ./scripts/run_mode_matrix_tests.sh",
    "desktop:analyze": "cd desktop && flutter analyze",
    "desktop:build:macos:debug": "cd desktop && flutter build macos --debug",
    "desktop:release:scripts:syntax:check": "cd desktop && ./scripts/check_release_script_syntax.sh",
    "desktop:release:scripts:syntax:contract:check": "cd desktop && ./scripts/check_release_script_syntax_contract.sh",
    "desktop:verify": "cd desktop && ./scripts/verify_desktop.sh",
    "desktop:verify:fast": "cd desktop && SKIP_PUB_GET=1 ./scripts/verify_desktop.sh",
    "desktop:verify:full": "cd desktop && INCLUDE_BUILD=1 ./scripts/verify_desktop.sh",
    "desktop:verify:full:fast": "cd desktop && SKIP_PUB_GET=1 INCLUDE_BUILD=1 ./scripts/verify_desktop.sh",
    "desktop:release:evidence:check": "cd desktop && ./scripts/check_release_evidence_index.sh",
    "desktop:release:evidence:contract:check": "cd desktop && ./scripts/check_release_evidence_index_contract.sh",
    "desktop:release:update-manifest:check": "cd desktop && ./scripts/check_update_manifest.sh",
    "desktop:release:installer-smoke:macos": "cd desktop && ./scripts/release_installer_update_smoke.sh macos release",
    "desktop:release:installer-smoke:windows": "cd desktop && ./scripts/release_installer_update_smoke.sh windows release",
    "desktop:release:evidence:row:macos": "cd desktop && ./scripts/generate_release_evidence_row.sh release/reports/installer_update_report_macos.json",
    "desktop:release:evidence:row:windows": "cd desktop && ./scripts/generate_release_evidence_row.sh release/reports/installer_update_report_windows.json",
    "desktop:release:evidence:bundle:macos": "cd desktop && ./scripts/generate_release_evidence_bundle.sh macos",
    "desktop:release:evidence:bundle:windows": "cd desktop && ./scripts/generate_release_evidence_bundle.sh windows",
    "desktop:release:evidence:bundle:check:macos": "cd desktop && ./scripts/check_release_evidence_bundle.sh macos",
    "desktop:release:evidence:bundle:check:windows": "cd desktop && ./scripts/check_release_evidence_bundle.sh windows",
    "desktop:release:evidence:bundle:check:macos:strict": "cd desktop && STRICT_RELEASE_EVIDENCE_BUNDLE=1 ./scripts/check_release_evidence_bundle.sh macos",
    "desktop:release:evidence:bundle:check:windows:strict": "cd desktop && STRICT_RELEASE_EVIDENCE_BUNDLE=1 ./scripts/check_release_evidence_bundle.sh windows",
    "desktop:release:evidence:index:preview:macos": "cd desktop && ./scripts/update_release_evidence_index.sh release/reports/release_evidence_row_macos.md ../docs/technical-guide/developer/desktop-flutter-release-evidence-index.md release/reports/release_evidence_index_preview_macos.md",
    "desktop:release:evidence:index:preview:windows": "cd desktop && ./scripts/update_release_evidence_index.sh release/reports/release_evidence_row_windows.md ../docs/technical-guide/developer/desktop-flutter-release-evidence-index.md release/reports/release_evidence_index_preview_windows.md",
    "desktop:release:evidence:index:apply:macos": "cd desktop && ./scripts/update_release_evidence_index.sh release/reports/release_evidence_row_macos.md ../docs/technical-guide/developer/desktop-flutter-release-evidence-index.md",
    "desktop:release:evidence:index:apply:windows": "cd desktop && ./scripts/update_release_evidence_index.sh release/reports/release_evidence_row_windows.md ../docs/technical-guide/developer/desktop-flutter-release-evidence-index.md",
    "desktop:release:appcast:generate": "cd desktop && ./scripts/generate_appcast_from_reports.sh",
    "desktop:release:appcast:generate:strict": "cd desktop && APPCAST_REQUIRE_BOTH_PLATFORMS=1 ./scripts/generate_appcast_from_reports.sh",
    "desktop:release:appcast:check": "cd desktop && ./scripts/check_appcast.sh",
    "desktop:release:appcast:publish:dry-run": "cd desktop && ./scripts/publish_appcast.sh",
    "desktop:release:appcast:bundle:generate": "cd desktop && ./scripts/generate_appcast_publication_bundle.sh",
    "desktop:release:appcast:bundle:check": "cd desktop && ./scripts/check_appcast_publication_bundle.sh",
    "desktop:release:smoke:gate-policy:check": "cd desktop && ./scripts/check_release_smoke_gate_policy.sh",
    "desktop:release:smoke:gate-policy:contract:check": "cd desktop && ./scripts/check_release_smoke_gate_policy_contract.sh",
    "desktop:release:appcast:external:production:guard": "cd desktop && ./scripts/guard_appcast_external_production.sh",
    "desktop:release:appcast:external:readiness": "cd desktop && ./scripts/check_appcast_external_readiness.sh",
    "desktop:release:appcast:external:readiness:strict": "cd desktop && STRICT_APPCAST_EXTERNAL_READINESS=1 ./scripts/check_appcast_external_readiness.sh",
    "desktop:release:appcast:publish:external:dry-run": "cd desktop && APPCAST_PUBLISH_DRY_RUN=1 ./scripts/publish_appcast_external.sh",
    "desktop:release:signing:readiness": "cd desktop && ./scripts/check_signing_readiness.sh",
    "desktop:release:signing:readiness:strict": "cd desktop && ./scripts/check_signing_readiness.sh 1",
    "desktop:release:signing:readiness:command-hooks:strict": "cd desktop && STRICT_SIGNING_COMMAND_HOOKS=1 ./scripts/check_signing_readiness.sh",
    "desktop:release:signing:readiness:placeholders:strict": "cd desktop && STRICT_SIGNING_PLACEHOLDERS=1 ./scripts/check_signing_readiness.sh",
    "desktop:release:signing:provenance:macos": "cd desktop && ./scripts/check_signing_artifact_provenance.sh macos",
    "desktop:release:signing:provenance:windows": "cd desktop && ./scripts/check_signing_artifact_provenance.sh windows",
    "desktop:release:signing:run:macos": "cd desktop && SKIP_PUB_GET=1 ./scripts/run_signing_with_build.sh macos 0 release",
    "desktop:release:signing:run:windows": "cd desktop && SKIP_PUB_GET=1 ./scripts/run_signing_with_build.sh windows 0 release",
    "desktop:release:windows-installer:run": "cd desktop && ./scripts/run_windows_installer_pipeline.sh",
    "desktop:release:windows-installer:check": "cd desktop && ./scripts/check_windows_installer_packaging.sh",
    "desktop:release:windows-installer:check:strict": "cd desktop && STRICT_WINDOWS_INSTALLER_NAMING=1 ./scripts/check_windows_installer_packaging.sh 1",
    "desktop:release:windows-installer:provenance": "cd desktop && ./scripts/check_windows_installer_provenance.sh",
    "desktop:release:windows-installer:provenance:strict": "cd desktop && ./scripts/check_windows_installer_provenance.sh 1"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "esbuild": "^0.25.9"
  }
}
