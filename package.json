{
  "name": "penjar",
  "version": "1.20.0",
  "license": "MPL-2.0",
  "author": "Kaleidos INC",
  "private": true,
  "packageManager": "pnpm@10.28.2+sha512.41872f037ad22f7348e3b1debbaf7e867cfd448f2726d9cf74c08f19507c31d2c8e7a11525b983febc2df640b5438dee6023ebb1f84ed43cc2d654d2bc326264",
  "repository": {
    "type": "git",
    "url": "https://github.com/penjar/penjar"
  },
  "type": "module",
  "scripts": {
    "lint": "./scripts/lint",
    "fmt": "./scripts/fmt",
    "desktop:test": "cd desktop && flutter test",
    "desktop:test:parity": "cd desktop && ./scripts/run_parity_tests.sh",
    "desktop:test:parity:no-pub": "cd desktop && FLUTTER_NO_PUB=1 ./scripts/run_parity_tests.sh",
    "desktop:test:mode-matrix": "cd desktop && ./scripts/run_mode_matrix_tests.sh",
    "desktop:test:mode-matrix:no-pub": "cd desktop && FLUTTER_NO_PUB=1 ./scripts/run_mode_matrix_tests.sh",
    "desktop:analyze": "cd desktop && flutter analyze",
    "desktop:build:macos:debug": "cd desktop && flutter build macos --debug",
    "desktop:verify": "cd desktop && ./scripts/verify_desktop.sh",
    "desktop:verify:full": "cd desktop && INCLUDE_BUILD=1 ./scripts/verify_desktop.sh"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "esbuild": "^0.25.9"
  }
}
