{
  "name": "mcp-meta",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "preflight": "bash ./scripts/preflight",
    "verify:phase-a": "bash ./scripts/verify-phase-a",
    "verify:auth-session": "bash ./scripts/verify-auth-session",
    "verify:project-lifecycle": "bash ./scripts/verify-project-lifecycle",
    "verify:file-lifecycle": "bash ./scripts/verify-file-lifecycle",
    "verify:canvas-editing": "bash ./scripts/verify-canvas-editing",
