    "verify:export-workflows": "bash ./scripts/verify-export-workflows",
    "verify:export-live": "bash ./scripts/verify-export-live",
    "verify:live-evidence": "bash ./scripts/verify-live-evidence",
    "build": "pnpm -r run build",
