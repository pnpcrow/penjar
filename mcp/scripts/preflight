#!/usr/bin/env bash

set -u

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

FAILURES=0
WARNINGS=0

MCP_PLUGIN_PORT="${PENPOT_MCP_PLUGIN_PORT:-4400}"
MCP_SERVER_PORT="${PENPOT_MCP_SERVER_PORT:-4401}"
MCP_WEBSOCKET_PORT="${PENPOT_MCP_WEBSOCKET_PORT:-4402}"
MCP_REPL_PORT="${PENPOT_MCP_REPL_PORT:-4403}"

log_info() {
    printf "[INFO] %s\n" "$1"
}

log_ok() {
    printf "[OK]   %s\n" "$1"
}

log_warn() {
    WARNINGS=$((WARNINGS + 1))
    printf "[WARN] %s\n" "$1"
}

log_fail() {
    FAILURES=$((FAILURES + 1))
    printf "[FAIL] %s\n" "$1"
}

print_section() {
    printf "\n== %s ==\n" "$1"
}

extract_major_version() {
    # Shell-only parser for versions like "v22.14.0" or "22.14.0"
    local raw="$1"
    raw="${raw#v}"
    printf "%s" "${raw%%.*}"
}

port_state() {
    local port="$1"

    if command -v lsof >/dev/null 2>&1; then
        if lsof -nP -iTCP:"$port" -sTCP:LISTEN >/dev/null 2>&1; then
            printf "in-use"
        else
            printf "free"
        fi
        return 0
    fi

    if command -v ss >/dev/null 2>&1; then
        if ss -ltn "( sport = :$port )" | tail -n +2 | grep -q .; then
            printf "in-use"
        else
            printf "free"
        fi
        return 0
    fi

    if command -v netstat >/dev/null 2>&1; then
        if netstat -an 2>/dev/null | grep -E "[\.\:]$port[[:space:]].*LISTEN" >/dev/null 2>&1; then
            printf "in-use"
        else
            printf "free"
        fi
        return 0
    fi

    printf "unknown"
}

check_required_commands() {
    print_section "Runtime prerequisites"

    local has_corepack=0
    local has_pnpm=0

    if command -v node >/dev/null 2>&1; then
        local node_version
        node_version="$(node -v)"
        local node_major
        node_major="$(extract_major_version "$node_version")"

        if [ "$node_major" -lt 20 ]; then
            log_fail "Node.js ${node_version} detected. Node.js >= 20 is required; v22.x is recommended."
        elif [ "$node_major" -ne 22 ]; then
            log_warn "Node.js ${node_version} detected. v22.x is the validated track for this MCP workspace."
        else
            log_ok "Node.js ${node_version} detected."
        fi
    else
        log_fail "Node.js is not installed or not available in PATH."
    fi

    if command -v corepack >/dev/null 2>&1; then
        has_corepack=1
        log_ok "corepack is available."
    else
        if command -v pnpm >/dev/null 2>&1; then
            log_warn "corepack is unavailable, but pnpm is already installed and will be used directly."
        else
            log_fail "corepack is required when pnpm is not already available."
        fi
    fi

    if command -v pnpm >/dev/null 2>&1; then
        has_pnpm=1
        local pnpm_version
        pnpm_version="$(pnpm --version 2>/dev/null || true)"
        if [ -n "$pnpm_version" ]; then
            log_ok "pnpm ${pnpm_version} is available."
        else
            log_fail "pnpm command exists but failed to report a version."
        fi
    else
        if [ "$has_corepack" -eq 1 ] && corepack pnpm --version >/dev/null 2>&1; then
            log_warn "pnpm is not globally available yet, but corepack can provision it."
        else
            log_fail "pnpm is unavailable and corepack could not provision it."
        fi
    fi

    if [ "$has_corepack" -eq 0 ] && [ "$has_pnpm" -eq 1 ]; then
        log_info "Skipping corepack-managed pnpm flow because pnpm is already available."
    fi
}

check_workspace_layout() {
    print_section "Workspace layout"

    if [ ! -f "$PROJECT_ROOT/package.json" ]; then
        log_fail "mcp/package.json not found. Run preflight from the mcp workspace."
        return
    fi

    if [ ! -d "$PROJECT_ROOT/packages/server" ] || [ ! -d "$PROJECT_ROOT/packages/plugin" ]; then
        log_fail "Expected workspace packages (server/plugin) are missing."
    else
        log_ok "Workspace layout looks correct."
    fi
}

check_port_uniqueness() {
    local ports=("$MCP_PLUGIN_PORT" "$MCP_SERVER_PORT" "$MCP_WEBSOCKET_PORT" "$MCP_REPL_PORT")
    local names=("plugin-preview" "mcp-http" "mcp-websocket" "mcp-repl")

    local i
    local j
    for ((i = 0; i < ${#ports[@]}; i++)); do
        for ((j = i + 1; j < ${#ports[@]}; j++)); do
            if [ "${ports[$i]}" = "${ports[$j]}" ]; then
                log_fail "Port collision: ${names[$i]} and ${names[$j]} both use ${ports[$i]}."
            fi
        done
    done
}

check_ports() {
    print_section "Local port availability"

    log_info "Expected ports: plugin=${MCP_PLUGIN_PORT}, mcp=${MCP_SERVER_PORT}, websocket=${MCP_WEBSOCKET_PORT}, repl=${MCP_REPL_PORT}"
    check_port_uniqueness

    local labels=("Plugin preview" "MCP HTTP/SSE" "MCP WebSocket" "MCP REPL")
    local ports=("$MCP_PLUGIN_PORT" "$MCP_SERVER_PORT" "$MCP_WEBSOCKET_PORT" "$MCP_REPL_PORT")

    local idx
    for ((idx = 0; idx < ${#ports[@]}; idx++)); do
        local state
        state="$(port_state "${ports[$idx]}")"
        if [ "$state" = "free" ]; then
            log_ok "${labels[$idx]} port ${ports[$idx]} is available."
        elif [ "$state" = "in-use" ]; then
            log_fail "${labels[$idx]} port ${ports[$idx]} is already in use. Find process with: lsof -nP -iTCP:${ports[$idx]} -sTCP:LISTEN"
        else
            log_warn "Could not determine if port ${ports[$idx]} is in use (install lsof, ss, or netstat)."
        fi
    done
}

print_remediation() {
    if [ "$FAILURES" -eq 0 ]; then
        return
    fi

    print_section "Remediation guide"
    printf "1. Install/upgrade Node.js (recommended: v22.x).\n"
    printf "2. Ensure corepack is enabled: corepack enable\n"
    printf "3. Install pnpm via corepack: corepack install\n"
    printf "4. Free occupied ports or override via env vars:\n"
    printf "   PENPOT_MCP_PLUGIN_PORT, PENPOT_MCP_SERVER_PORT, PENPOT_MCP_WEBSOCKET_PORT, PENPOT_MCP_REPL_PORT\n"
}

print_summary() {
    print_section "Summary"
    printf "Failures: %s\n" "$FAILURES"
    printf "Warnings: %s\n" "$WARNINGS"

    if [ "$FAILURES" -gt 0 ]; then
        printf "Result: preflight failed.\n"
    else
        printf "Result: preflight passed.\n"
    fi
}

main() {
    printf "Penpot MCP preflight checks\n"
    printf "Workspace: %s\n" "$PROJECT_ROOT"

    check_workspace_layout
    check_required_commands
    check_ports
    print_remediation
    print_summary

    if [ "$FAILURES" -gt 0 ]; then
        exit 1
    fi
}

main "$@"
